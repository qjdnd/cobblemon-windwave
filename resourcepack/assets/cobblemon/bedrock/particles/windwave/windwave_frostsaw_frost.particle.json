{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblemon:windwave_frostsaw_frost",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particles/generic/orb/xsfadeorb"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "40*math.clamp(v.entity_size,1,2)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_disc": {
        "radius": 0.2,
        "plane_normal": "y",
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 1.0)"
      },
      "minecraft:particle_initial_speed": "math.random(6, 11)*math.clamp(v.entity_size,1,3)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.5,
          0
        ],
        "linear_drag_coefficient": 4
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.22",
          "0.22"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 45,
          "texture_height": 5,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              5,
              5
            ],
            "step_UV": [
              5,
              0
            ],
            "frames_per_second": 10,
            "max_frame": 9,
            "stretch_to_lifetime": true
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.3": "#FFC4F0FF",
            "1.0": "#0092BCFF"
          }
        }
      }
    }
  }
}
